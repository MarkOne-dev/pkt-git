#!/usr/bin/env bash
# ============================================================================
# post-merge / post-checkout — pkt-git
#
# Después de un git pull/merge o cambio de rama: si el snapshot textual
# cambió respecto a la referencia anterior, REGENERA los .pkt locales para
# que Packet Tracer abra el estado que acaba de llegar del repo.
# ============================================================================
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=".venv/bin/python"

OLD="${1:-}"; NEW="${2:-}"

if [[ -n "$OLD" && "$OLD" != *0000000000* ]]; then
    RANGE=("$OLD" "$NEW")
else
    # post-merge o checkout inicial de rama
    RANGE=("ORIG_HEAD" "HEAD")
fi

files=$(git diff --name-only "${RANGE[@]}" 2>/dev/null -- 'snapshot/*/base.snapshot.xml' || true)

for xml in $files; do
    proj=$(basename "$(dirname "$xml")")
    pkt="topologia/$proj.pkt"
    echo "[pkt-git] snapshot de '$proj' actualizado por merge/checkout."
    echo "          Regenerando $pkt ..."
    mkdir -p "$(dirname "$pkt")"
    "$PY" tools/ptg.py build "$xml" "$pkt" || {
        echo "❌ ERROR regenerando $pkt — abre snapshot/ y revisa manualmente."
        continue
    }
    echo "✅ $pkt regenerado — ábrelo en Packet Tracer para revisar la red."
done

exit 0
