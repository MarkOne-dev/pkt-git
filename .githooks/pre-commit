#!/usr/bin/env bash
# pre-commit hook — pkt-git
#
# Guarantee: no commit with a changed .pkt goes without its textual snapshot.
# If the .pkt changed, run 'ptg export' and stage the snapshot updates.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=".venv/bin/python"

LOG=$(mktemp); trap 'rm -f "$LOG"' EXIT

changed=0
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    base="$(basename "$f" .pkt)"
    dir="snapshot/$base"

    echo "[pre-commit] .pkt changed: $f -> exporting snapshot to $dir/"
    "$PY" tools/ptg.py export "$f" "$dir" > "$LOG" 2>&1 || {
        echo "ERROR exporting snapshot of $f — details:"; cat "$LOG"; exit 1
    }
    sed 's/^/[pre-commit] /' "$LOG"

    git add -- "$dir" 2>/dev/null || true
    changed=1
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.pkt')

if [[ $changed -eq 1 ]]; then
    echo "[pre-commit] textual snapshot included automatically ✓"
fi

# opposite case: snapshot changed without its .pkt (textual edit/merge)
if ! git diff --cached --name-only -- '*.pkt' | grep -q .; then
    if git diff --cached --name-only --diff-filter=MCR 'snapshot/*/base.snapshot.xml' | grep -q .; then
        echo "⚠ Warning: textual snapshot changed without its .pkt."
        echo "  This is valid (textual edit/merge), but remember to rebuild"
        echo "  the binary before opening Packet Tracer:  ptg build"
    fi
fi

exit 0
