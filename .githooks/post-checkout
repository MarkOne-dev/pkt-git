#!/usr/bin/env bash
# post-merge / post-checkout hook — pkt-git
#
# After a pull/merge or branch switch: if the textual snapshot changed,
# rebuild the local .pkt files so Packet Tracer opens the repo state.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=".venv/bin/python"

OLD="${1:-}"; NEW="${2:-}"

if [[ -n "$OLD" && "$OLD" != *0000000000* ]]; then
    RANGE=("$OLD" "$NEW")
else
    RANGE=("ORIG_HEAD" "HEAD")
fi

files=$(git diff --name-only "${RANGE[@]}" 2>/dev/null -- 'snapshot/*/base.snapshot.xml' || true)

for xml in $files; do
    proj=$(basename "$(dirname "$xml")")
    pkt="topologia/$proj.pkt"
    echo "[pkt-git] snapshot of '$proj' updated by merge/checkout."
    echo "          Rebuilding $pkt ..."
    mkdir -p "$(dirname "$pkt")"
    "$PY" tools/ptg.py build "$xml" "$pkt" || {
        echo "ERROR rebuilding $pkt — inspect snapshot/ manually."
        continue
    }
    echo "✅ $pkt rebuilt — open it in Packet Tracer to review the network."
done

exit 0
